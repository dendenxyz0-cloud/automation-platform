# .env.example
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/automation_platform
REDIS_URL=redis://:change_me@localhost:6379/0
SECRET_KEY=replace_with_a_long_random_secret

POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=automation_platform
REDIS_PASSWORD=change_me
# JSON array of proxy objects, for example: [{"ip":"proxy.example.com","port":8080,"username":"...","password":"..."}]
PROXY_CONFIGS_JSON=[]
PROXY_HEALTHCHECK_URL=https://example.com/
PROXY_HEALTHCHECK_TIMEOUT_MS=5000
AUTOMATION_RATE_LIMIT_PER_HOUR=30
COMPLIANCE_KILL_SWITCH=false
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
